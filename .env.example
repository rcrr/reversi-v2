# Template for the local .env (copy it: cp .env.example .env, then fill in
# your own values). The .env file itself is gitignored — never commit it.

# The PostgreSQL server holding the regab data set (the DB-gated tests and
# the pipeline's data extraction connect with these).
DB_NAME=tst_regab
DB_USER=tst_regab
DB_PASSWORD=CHANGE-ME
DB_HOST=localhost
DB_PORT=5432

# The arguments of the test/reversi/test_regab.py extraction test (they must
# match a real bid/status/ec combination in YOUR regab data set).
TEST_RDATA_TEST_EXTRACTION_ARG_BID=7
TEST_RDATA_TEST_EXTRACTION_ARG_STATUS=CMS,CMR
TEST_RDATA_TEST_EXTRACTION_ARG_EC=20
TEST_RDATA_TEST_EXTRACTION_EXPECTED_COUNT=20
