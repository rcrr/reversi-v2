{
    "name": "RGLM (Logistic) - I-017 Experiment 05 (rlm_05.json, 2M)",
    "description": "The I-017 SU-analysis experiment: the G0 corpus (2M positions, ec 20) + the feature_analysis, the target_level FEATURE_ANALYSIS (the stop before the DB levels). A copy of rlm_03 (the A2050 feature set, the DB connection kept for schema validity, unused at this target level).",
    "base_dir": "will/be/overwritten/by/python/during/unittesting",
    "output": "rglm_logistic_model_ec_20_TEST05.dat",
    "use_cache": true,
    "cache_files_prefix": "rlmwf_",
    "regab_allow_duplicate": true,
    "stat_model": {
        "frequency_cut_off": 1,
        "logit_clipping": 0.01,
        "ridge_regularization": 0.01,
    },
    "optimization": {
        "max_iters": 500,
        "m": 93,
        "c1": 0.0001,
        "c2": 0.9,
        "min_grad": [1e-5, 5],
        "min_p_fun_decrease": [1e-6, 5],
        "log_every_n": 1,
        "save_every_n": 100,
        "checkpoint_file": "checkpoint_optimize.dat",
        "high_performance_fg": true
    },
    "analytics": {
        "report_file_name": "model_analytics_report.txt",
        "detailed_report": ["XEDGE"]
    },
    "regab_data_set": {
        "regab_db_connection": {
            "dbname": "tst_regab",
            "user": "tst_regab",
            "host": "localhost"
        },
        "bid": [3],
        "status": ["CMR", "CMS"],
        "ec": 20
    },
    "validation_data_set": {
        "bid": [6],
        "status": ["CMS", "CMR"]
    },
    "feature_set": {
        "intercept": true,
        "pattern_set": {
            "name": "A2050",
            "patterns": [
                { "name": "XEDGE",  "mask": "00000000000042FF" },
                { "name": "CORNER", "mask": "0000000000070707" },
                { "name": "R2",     "mask": "000000000000FF00" },
                { "name": "R3",     "mask": "0000000000FF0000" },
                { "name": "R4",     "mask": "00000000FF000000" },
                { "name": "DIAG4",  "mask": "0000000001020408" },
                { "name": "DIAG5",  "mask": "0000000102040810" },
                { "name": "DIAG6",  "mask": "0000010204081020" },
                { "name": "DIAG7",  "mask": "0001020408102040" },
                { "name": "DIAG8",  "mask": "0102040810204080" },
                { "name": "2X5COR", "mask": "0000000000001F1F" }
            ]
        },
        "mobility_set": {
            "name": "BasicMobilitySet",
            "mobility_features": [
                { "name": "LMC", "mask": "FFFFFFFFFFFFFFFF", "amask": "0000000000000000" }
            ]
        }
    },
    "feature_analysis": {
        "enable": true,
        "corpus": {
            "seed": 42,
            "total_positions": 2000000,
            "ec": 20
        },
        "su_pairs": [["LMC", "XEDGE"], ["LMC", "R2"], ["LMC", "CORNER"]],
        "dir_name": "feature_analysis",
        "report_file_name": "feature_analysis_report.txt",
        "export_csv": false
    },
    "target_level": "FEATURE_ANALYSIS"
}
